{
  "name": "@solutionforest/android-health-connect",
  "version": "0.3.14",
  "description": "React Native TurboModule for Android Health Connect — read/write health records, permissions, matchmaking, and PHR helpers.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./lib/module/index.js",
      "import": "./lib/module/index.js",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin/build",
    "plugin/src",
    "react-native.config.js",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "llms.txt",
    "skills.md",
    "!ios/build",
    "!android/build",
    "!android/src/test",
    "!android/unit-test-runner",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace android-health-connect-example",
    "clean": "del-cli android/build example/android/build example/android/app/build lib",
    "prepare": "bob build && tsc -p plugin/tsconfig.json",
    "plugin:build": "tsc -p plugin/tsconfig.json",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "test:android": "yarn turbo run test:android --filter=android-health-connect-example",
    "pack:check": "yarn pack --dry-run",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "android",
    "health-connect",
    "healthconnect",
    "fitness",
    "healthcare",
    "turbo-module",
    "expo",
    "permissions",
    "wearables"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solutionforest/AndroidHealthConnect.git"
  },
  "author": "Jayden Chan <jayden.chan@solutionforest.net> (https://github.com/kfchan-git)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/solutionforest/AndroidHealthConnect/issues"
  },
  "homepage": "https://solutionforest.github.io/AndroidHealthConnect/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@expo/config-plugins": ">=8.0.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "lefthook": "^2.0.3",
    "prettier": "^2.8.8",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.40.18",
    "react-test-renderer": "19.2.3",
    "release-it": "^19.0.4",
    "turbo": "^2.9.14",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "expo": ">=50.0.0",
    "react": "*",
    "react-native": ">=0.84.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "AndroidHealthConnectSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.androidhealthconnect"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/NativeAndroidHealthConnect.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true,
      "releaseName": "v${version}",
      "comments": {
        "submit": false
      }
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.57.2"
  },
  "resolutions": {
    "handlebars": "^4.7.10",
    "shell-quote": "^1.9.0",
    "tar": "^7.5.21",
    "@xmldom/xmldom": "^0.8.15",
    "undici": "^6.29.1",
    "fast-uri": "^3.1.9",
    "brace-expansion@^1.1.7": "^1.1.21",
    "brace-expansion@^2.0.2": "^2.1.7",
    "brace-expansion@^5.0.5": "^5.0.12",
    "js-yaml@^3.13.1": "^3.15.2",
    "js-yaml@^4.1.0": "^4.3.2",
    "js-yaml@^4.1.1": "^4.3.2",
    "ws@^6.2.3": "^6.2.4",
    "ws@^7": "^7.5.11",
    "ws@^7.5.10": "^7.5.11",
    "body-parser": "^1.20.9",
    "compression": "^1.8.2",
    "browserslist": "^4.28.7",
    "ip-address": "^10.7.1",
    "launch-editor": "^2.14.2",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "@babel/core": "^7.29.6",
    "qs": "^6.16.1",
    "baseline-browser-mapping": "^2.11.0",
    "@humanfs/node": "^0.16.8",
    "zod": "^4.6.6",
    "basic-ftp": "^6.2.4",
    "uuid@^7.0.3": "^11.1.1",
    "minimatch@^10.2.2": "^11.0.1",
    "fast-xml-parser": "^5.12.0",
    "glob@^10.5.0": "^14.0.2",
    "glob@^13.0.0": "^14.0.2"
  }
}
